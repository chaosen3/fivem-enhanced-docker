# Copy to .env. Both services read it. Never commit .env.

# The FXServer Linux artifact to run. For GTAV Enhanced take the Linux link
# from https://docs.fivem.net/docs/server-download/ (a downloads.cfx-services.net
# URL ending in cfx-server_linux_x64.tar.xz, new UUID per build). Change it and
# `docker compose up -d` to move to another build.
CFX_URL=REPLACE_ME
# Optional: sha256 of that .tar.xz; the fetch fails if the download differs.
CFX_SHA256=

TZ=Europe/London

# txAdmin v8+ reads these TXHOST_* variables; its older ConVars are ignored
# silently, so a headless setup still using them boots txAdmin blank.
TXHOST_DATA_PATH=/txData
TXHOST_INTERFACE=0.0.0.0
TXHOST_TXA_PORT=40120
TXHOST_TXA_URL=REPLACE_ME              # the public URL txAdmin is reached on
TXHOST_GAME_NAME=fivem
TXHOST_IGNORE_DEPRECATED_CONFIGS=true

# MariaDB. The same values go in server.cfg's mysql_connection_string:
#   set mysql_connection_string "mysql://fivem:<password>@mariadb/fivem?charset=utf8mb4"
MARIADB_ROOT_PASSWORD=REPLACE_ME
MARIADB_DATABASE=fivem
MARIADB_USER=fivem
MARIADB_PASSWORD=REPLACE_ME
